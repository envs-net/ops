#!/usr/bin/env bash
# envs.net account provisioning and deprovisioning.
# Signup review/archiving belongs exclusively to envs_signups_review.
set -Eeuo pipefail
umask 077

readonly domain='envs.net'
readonly short_dom="${domain%%.*}"
readonly tmpl_dir='/usr/local/bin/envs.net'

cmd="${1:-}"
user="${2:-}"
mailTo="${3:-}"
ssh_pubkey="${4:-}"
# Kept for compatibility with envs_signups_review: any fifth argument skips
# the expensive user-info page update (e.g. "skip").
no_user_update="${5:-}"
newpw=''
pwcrypt=''

usage() {
	cat <<USAGE
$domain | User Account Setup

Usage:
  $(basename "$0") add USER EMAIL [SSH_PUBLIC_KEY] [NO_USER_UPDATE]
  $(basename "$0") del USER
  $(basename "$0") add_mysql USER
  $(basename "$0") del_mysql USER

PostgreSQL helper functions are retained but not exposed by the CLI.
USAGE
}

fail() {
	printf '[ERROR] %s\n' "$*" >&2
	exit 1
}

warn() {
	printf '[WARN] %s\n' "$*" >&2
}

require_username() {
	[[ -n "$user" && "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || \
		fail 'Invalid username (expected a Linux account name up to 32 characters)'
}

require_email() {
	# Besides basic validity, this excludes CR/LF header injection.
	[[ "$mailTo" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || \
		fail 'Invalid destination email address'
}

require_ssh_key() {
	[[ -z "$ssh_pubkey" ]] && return 0
	[[ "$ssh_pubkey" != *$'\n'* && "$ssh_pubkey" != *$'\r'* ]] || \
		fail 'SSH public key must be a single line'
	printf '%s\n' "$ssh_pubkey" | ssh-keygen -lf - >/dev/null 2>&1 || \
		fail 'Invalid SSH public key'
}

# Only generate credentials for commands that need them, not for del/help.
make_password() {
	command -v pwgen >/dev/null 2>&1 || fail 'pwgen is missing'
	newpw=$(pwgen -s 16 1) || fail 'Password generation failed'
	[[ "$newpw" =~ ^[A-Za-z0-9]{16}$ ]] || fail 'Unexpected characters from pwgen'
}

make_password_hash() {
	command -v openssl >/dev/null 2>&1 || fail 'openssl is missing'
	pwcrypt=$(printf '%s\n' "$newpw" | openssl passwd -6 -stdin) || \
		fail 'Password hashing failed'
	[[ "$pwcrypt" == '$6$'* ]] || fail 'Unexpected password hash format'
}

send_text_mail() {
	local from="$1" to="$2" cc="$3" subject="$4"
	{
		printf 'MIME-Version: 1.0\r\n'
		printf 'Content-Type: text/plain; charset=UTF-8\r\n'
		printf 'Content-Transfer-Encoding: 8bit\r\n'
		printf 'From: %s\r\n' "$from"
		printf 'To: %s\r\n' "$to"
		if [[ -n "$cc" ]]; then
			printf 'Cc: %s\r\n' "$cc"
		fi
		printf 'Subject: %s\r\n\r\n' "$subject"
		cat
	} | sendmail -oi -t
}

send_db_mail() {
	local db_type="$1"
	sed -e "s/_username_/$user/g" \
		-e "s/_password_/$newpw/g" \
		-e "s/_sql_/$db_type/g" \
		"$tmpl_dir/database-email.tmpl" | \
		send_text_mail "sudoers@$domain" "$user@$domain" '' \
			"envs - $db_type database readme"
}

add_user_mysql_db() {
	make_password
	mysql -u root <<SQL
CREATE DATABASE \`$user\`;
GRANT ALL PRIVILEGES ON \`$user\`.* TO '$user'@'localhost' IDENTIFIED BY '$newpw';
FLUSH PRIVILEGES;
SQL
	send_db_mail mysql
}

del_user_mysql_db() {
	local present
	present=$(mysql -u root -qfsBe \
		"SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME='$user'")
	if [[ -n "$present" ]]; then
		mysql -u root <<SQL
DROP DATABASE \`$user\`;
DROP USER IF EXISTS '$user'@'localhost';
FLUSH PRIVILEGES;
SQL
	fi
}

# Retained from the original script, not available in the case dispatcher.
add_user_pgsql_db() {
	make_password
	sudo -u postgres psql -v ON_ERROR_STOP=1 <<SQL
CREATE USER "$user";
ALTER USER "$user" WITH PASSWORD '$newpw';
CREATE DATABASE "$user" ENCODING 'UTF8' LC_COLLATE='C' LC_CTYPE='C' template=template0 OWNER "$user";
GRANT ALL PRIVILEGES ON DATABASE "$user" TO "$user";
SQL
	send_db_mail pgsql
}

del_user_pgsql_db() {
	sudo -u postgres psql -v ON_ERROR_STOP=1 <<SQL
DROP DATABASE IF EXISTS "$user";
DROP OWNED BY "$user";
DROP USER IF EXISTS "$user";
SQL
}

# Called only after useradd; do not leave an incomplete account active.
fail_partial_account() {
	# Avoid triggering the ERR trap again while reporting the original error.
	trap - ERR
	usermod --expiredate 1 "$user" || warn "Could not expire incomplete account $user"
	fail "$* (account $user expired; investigate before retrying)"
}

on_provision_error() {
	local status="$1"
	fail_partial_account "Account provisioning failed with exit status $status"
}

add_user() {
	local home="/home/$user" required

	# Catch missing dependencies/templates before creating a Unix account.
	for required in useradd usermod setquota xfs_quota lxc-attach sendmail sudo; do
		command -v "$required" >/dev/null 2>&1 || fail "Missing command: $required"
	done
	[[ -r "$tmpl_dir/welcome-readme.tmpl" && -r "$tmpl_dir/welcome-email.tmpl" ]] || \
		fail 'Welcome email templates are missing or unreadable'
	if [[ -z "$ssh_pubkey" ]]; then
		[[ -t 0 ]] || fail 'No SSH key supplied and no interactive terminal available'
		command -v "${EDITOR:-nano}" >/dev/null 2>&1 || fail 'SSH key editor is missing'
	fi

	make_password
	make_password_hash

	useradd -m -g 9999 -s /bin/bash -p "$pwcrypt" "$user"
	# An error at any later essential step leaves an expired account, so the
	# signup reviewer cannot accidentally accept incomplete provisioning.
	trap 'on_provision_error "$?"' ERR

	# Keep the established direct quota configuration on this server.
	# setquota uses block sizes accepted by the installed quota-tools version.
	if ! setquota -u "$user" 1G 1G 100000 100000 /tmp; then
		fail_partial_account 'Unable to assign /tmp quota (1 GiB / 100000 inodes)'
	fi
	if ! xfs_quota -x -c "limit bsoft=1048576k bhard=1572864k $user" /home; then
		fail_partial_account 'Unable to assign /home XFS quota'
	fi
	usermod -aG xmppusers "$user" || fail_partial_account 'Unable to assign xmppusers group'

	# PAM reads only *.conf from limits.d; remove any legacy un-suffixed file.
	rm -f -- "/etc/security/limits.d/$user"
	printf '%s\tsoft\tnproc\t256\n%s\thard\tnproc\t512\n' \
		"$user" "$user" > "/etc/security/limits.d/$user.conf"
	chmod 0644 "/etc/security/limits.d/$user.conf"

	if [[ -d "$home/.config/systemd/user" ]]; then
		chown -R "$user:$short_dom" "$home/.config/systemd/user"
	fi

	# Configure SSH keys before creating and notifying the mailbox.
	install -d -m 0700 -o "$user" -g "$short_dom" "$home/.ssh"
	if [[ -n "$ssh_pubkey" ]]; then
		printf '%s\n' "$ssh_pubkey" > "$home/.ssh/authorized_keys"
	else
		[[ -t 0 ]] || fail_partial_account 'No SSH key supplied and no interactive terminal available'
		"${EDITOR:-nano}" "$home/.ssh/authorized_keys"
	fi
	chmod 0600 "$home/.ssh/authorized_keys"
	chown "$user:$short_dom" "$home/.ssh/authorized_keys"

	# Mail aliases: retain existing envs.net behavior.
	printf '%s: %s@%s\n' "$user" "$user" "$domain" >> /etc/aliases
	printf '%s: %s@%s\n' "$user" "$user" "$domain" >> /etc/email-addresses

	# Call coreapi directly; avoid shell interpolation and suppress only stdout.
	if ! lxc-attach -n mail -- /usr/local/bin/coreapi action accounts create \
		-p "username=$user@$domain" -p 'role=SimpleUsers' \
		-p 'language=en' -p "password=$newpw" \
		-p "secondary_email=$mailTo" >/dev/null; then
		fail_partial_account 'Mail account creation failed'
	fi

	# Give the mail service its existing propagation delay.
	sleep 3
	if ! send_text_mail "sudoers@$domain" "$mailTo" "$user@$domain" \
		"Welcome $user | please readme!" < "$tmpl_dir/welcome-readme.tmpl"; then
		fail_partial_account 'Readme email submission failed'
	fi
	if ! sed -e "s/_username_/$user/g" -e "s/_password_/$newpw/g" \
		"$tmpl_dir/welcome-email.tmpl" | \
		send_text_mail "hosting@$domain" "$mailTo" "$user@$domain" \
			"Welcome to $domain | $user"; then
		fail_partial_account 'Welcome email submission failed'
	fi

	# Mailing-list subscription should not undo successful account creation.
	if ! printf 'MIME-Version: 1.0\r\nContent-Type: text/plain; charset=UTF-8\r\nTo: team-join@%s\r\nFrom: %s@%s\r\nSubject: subscribe\r\n\r\n' \
		"$domain" "$user" "$domain" | sudo -u "$user" sendmail -oi -t; then
		warn "Mailing-list subscription failed for $user"
	fi

	if [[ -f "$home/.muttrc" ]]; then
		sed -i -e "s/_username_/$user/g" -e "s/_password_/$newpw/g" "$home/.muttrc"
		chmod 0600 "$home/.muttrc"
	fi
	install -d -m 0700 -o "$user" -g "$short_dom" "$home/.mutt"
	printf '\n%s\n' "$user" > "$home/.mutt/signature"
	chown "$user:$short_dom" "$home/.mutt/signature"

	if [[ -f "$home/.weechat/irc.conf" ]]; then
		sed -i "s/_username_/$user/g" "$home/.weechat/irc.conf"
	fi
	if [[ -d "$home/.weechat" ]]; then
		chmod 0700 "$home/.weechat"
	fi

	rm -rf -- "$home/.git" "$home/.drone.yml" "$home/README.md"

	if [[ -z "$no_user_update" ]]; then
		if ! "$tmpl_dir/envs_user_info.sh"; then
			warn "User-info refresh failed for $user"
		fi
	fi
	if ! sudo -u services toot post "welcome new user ~$user"; then
		warn "Mastodon announcement failed for $user"
	fi

	trap - ERR
	printf '[INFO] Account %s provisioned.\n' "$user"
	printf '[INFO] /home XFS quota: soft 1 GiB, hard 1.5 GiB.\n'
	printf '[INFO] /tmp quota: soft/hard 1 GiB, soft/hard 100000 inodes.\n'
	# Do not remove /var/signups_current here: review owns queue/archiving.
}

# Keep the provisioner out of the account while its backends are removed.
# This is the SAME lock used by envs_web_autoprovision (v1.2.2). Hold its
# descriptor until this script exits, including during userdel.
web_autoprovision_lock_fd=''

lock_web_autoprovision_for_deletion() {
    local lock='/run/envs-web-autoprovision.lock' metadata
    command -v flock >/dev/null 2>&1 || fail 'flock is required for safe web deprovisioning'
    if [[ -e "$lock" || -L "$lock" ]]; then
        [[ ! -L "$lock" && -f "$lock" ]] || fail "Unsafe autoprovision lock: $lock"
        metadata=$(stat -c '%u:%a:%h' -- "$lock") || fail 'Cannot inspect autoprovision lock'
        [[ "$metadata" == '0:600:1' ]] || fail "Unexpected autoprovision lock metadata: $metadata"
    fi
    exec {web_autoprovision_lock_fd}<> "$lock" || fail "Cannot open $lock"
    metadata=$(stat -c '%u:%a:%h' -- "$lock") || fail 'Cannot inspect opened autoprovision lock'
    [[ "$metadata" == '0:600:1' ]] || fail "Unexpected autoprovision lock metadata: $metadata"
    flock -n "$web_autoprovision_lock_fd" || \
        fail 'Web auto-provisioner is running; retry deletion after it finishes'
}

# A removed route falls back to the old shared backend in the nginx map.
# These existing guards must reject that fallback, or deletion must stop.
check_web_fail_closed_for_deletion() {
    local php_guard='if ($envs_php_backend = "unix:/run/php/php8.4-fpm.sock") {'
    local cgi_guard='if ($envs_cgi_backend = "unix:/run/fcgiwrap.socket") {'
    grep -Fq -- "$php_guard" /etc/nginx/snippets/user.envs.conf || \
        fail 'Missing PHP fail-closed guard in user.envs.conf'
    grep -Fq -- "$php_guard" /etc/nginx/snippets/envs_user_alias_php || \
        fail 'Missing PHP fail-closed guard for user aliases'
    grep -Fq -- "$cgi_guard" /etc/nginx/snippets/user.envs.conf || \
        fail 'Missing CGI fail-closed guard in user.envs.conf'
    grep -Fq -- "$cgi_guard" /etc/nginx/sites-enabled/envs.net.conf || \
        fail 'Missing CGI fail-closed guard for user aliases'
}

# User MUST still exist: all manager actions check NSS, UID and /home.
# If any step fails, stop before userdel. Re-running del is supported:
# unroute is idempotent; installed/absent units are checked individually.
deprovision_user_web() {
    local uid="$1" manager='/usr/local/sbin/envs_php_fpm_manage'
    local pool="/etc/envs/php-fpm/user-$user.conf"
    local marker="/etc/envs/php-fpm/user-$user.allow"
    local php_boot="/etc/systemd/system/sockets.target.wants/envs-php-user@$user.socket"
    local cgi_svc="/etc/systemd/system/envs-cgi-user-$user.service"
    local cgi_sock="/etc/systemd/system/envs-cgi-user-$user.socket"
    local cgi_boot="/etc/systemd/system/sockets.target.wants/envs-cgi-user-$user.socket"

    [[ -x "$manager" ]] || fail "Missing executable web manager: $manager"
    lock_web_autoprovision_for_deletion
    [[ "$(id -u -- "$user")" == "$uid" ]] || fail 'UID changed while preparing web cleanup'
    check_web_fail_closed_for_deletion

    # Reject partial PHP installs, but allow accounts that never used PHP.
    if [[ ! -e "$pool" && ! -L "$pool" ]]; then
        if [[ -e "$marker" || -L "$marker" || -e "$php_boot" || -L "$php_boot" ]] || \
           systemctl is-active --quiet "envs-php-user@$user.socket" || \
           systemctl is-active --quiet "envs-php-user@$user.service"; then
            fail 'PHP-FPM pool missing but activation state exists; manual review required'
        fi
    fi

    printf '[INFO] Retiring nginx PHP/CGI routes for %s (UID %s).\n' "$user" "$uid"
    "$manager" unroute "$user" --commit --confirm-uid "$uid" || \
        fail 'PHP unroute failed; Unix account has NOT been deleted'
    "$manager" cgi-unroute "$user" --commit --confirm-uid "$uid" --confirm-legacy-fallback || \
        fail 'CGI unroute failed; Unix account has NOT been deleted'

    # Account deletion intentionally permits old nginx workers to finish
    # with errors if they still reference this account. Routes are already
    # removed; --retire-user bypasses ONLY the global draining-worker check.
    if [[ -e "$pool" || -L "$pool" ]]; then
        "$manager" disable "$user" --commit --confirm-uid "$uid" --retire-user || \
            fail 'PHP disable failed; Unix account has NOT been deleted'
        "$manager" remove "$user" --commit --confirm-uid "$uid" --retire-user || \
            fail 'PHP remove failed; Unix account has NOT been deleted'
    fi

    if [[ -e "$cgi_svc" || -L "$cgi_svc" || -e "$cgi_sock" || -L "$cgi_sock" ]]; then
        "$manager" cgi-disable "$user" --commit --confirm-uid "$uid" --retire-user || \
            fail 'CGI disable failed; Unix account has NOT been deleted'
        "$manager" cgi-remove "$user" --commit --confirm-uid "$uid" --retire-user || \
            fail 'CGI remove failed; Unix account has NOT been deleted'
    elif [[ -e "$cgi_boot" || -L "$cgi_boot" ]] || \
         systemctl is-active --quiet "envs-cgi-user-$user.socket" || \
         systemctl is-active --quiet "envs-cgi-user-$user.service"; then
        fail 'CGI unit files missing but activation state exists; manual review required'
    fi

    # Confirm that no managed route remains before deleting the shell UID.
    if grep -Fq -- "unix:/run/envs-php-user-$user/php.sock;" \
            /etc/nginx/sites-enabled/user.envs.net.conf || \
       grep -Fq -- "unix:/run/envs-cgi-user-$user/fcgiwrap.sock;" \
            /etc/nginx/conf.d/envs-cgi-backends.conf; then
        fail 'Stale private nginx route remains; Unix account has NOT been deleted'
    fi
    printf '[INFO] PHP-FPM/CGI cleanup completed for %s.\n' "$user"
}

# Refuse destructive operations against accounts outside /home/<username>.
check_deletion_target() {
	local entry uid home
	entry=$(getent passwd "$user") || fail "Account not found: $user"
	IFS=: read -r _ _ uid _ _ home _ <<< "$entry"
	[[ "$home" == "/home/$user" ]] || \
		fail "Refusing to delete non-shell account $user (home: $home)"
	[[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 ]] || \
		fail "Refusing to delete privileged account $user (UID: $uid)"
}

del_user() {
	local mailbox_json mail_userid
	check_deletion_target

	# Resolve the mailbox before deleting the Unix account; refuse ambiguous matches.
	mailbox_json=$(lxc-attach -n mail -- /usr/local/bin/coreapi action accounts list \
		-p "search=$user@$domain") || fail "Mailbox lookup failed for $user"
	mail_userid=$(printf '%s\n' "$mailbox_json" | jq -er '
		[.[] | .pk | select(. != null)] |
		if length > 1 then error("ambiguous mailbox lookup")
		elif length == 1 then .[0] | tostring
		else "" end
	') || fail "Cannot identify a unique mailbox for $user"

	# Must happen BEFORE userdel: web manager validates the existing UID/home.
	# The autoprovisioner lock stays open until script exit.
	local delete_uid
	delete_uid=$(id -u -- "$user") || fail "Cannot resolve UID for $user"
	deprovision_user_web "$delete_uid"

	if ! printf 'MIME-Version: 1.0\r\nContent-Type: text/plain; charset=UTF-8\r\nTo: team-leave@%s\r\nFrom: %s@%s\r\nSubject: leave\r\n\r\n' \
		"$domain" "$user" "$domain" | sudo -u "$user" sendmail -oi -t; then
		warn "Mailing-list unsubscribe failed for $user"
	fi

	if command -v loginctl >/dev/null 2>&1; then
		loginctl terminate-user "$user" 2>/dev/null || true
	fi
	pkill -KILL -u "$user" 2>/dev/null || true
	userdel -rf "$user"

	rm -f -- "/etc/security/limits.d/$user" "/etc/security/limits.d/$user.conf"
	if [[ -f /etc/aliases ]]; then
		sed -i "/^${user}:/d" /etc/aliases
	fi
	if [[ -f /etc/email-addresses ]]; then
		sed -i "/^${user}:/d" /etc/email-addresses
	fi

	if [[ -n "$mail_userid" ]]; then
		lxc-attach -n mail -- /usr/local/bin/coreapi action accounts delete \
			-p "id=$mail_userid"
	else
		warn "No matching mailbox found for $user"
	fi

	del_user_mysql_db
	if [[ -L "/var/gemini/~$user" ]]; then
		unlink "/var/gemini/~$user"
	fi

	printf '\n[INFO] Review orphaned /tmp files and quota for the old UID separately.\n'
	printf '!!! ADMIN: please remove %s also from lists.%s and znc.%s !!!\n\n' \
		"$user" "$domain" "$domain"
}

case "$cmd" in
	''|-h|--help|help)
		usage
		exit 0
		;;
	add)
		(( EUID == 0 )) || fail 'Please run as root!'
		[[ $# -ge 3 && $# -le 5 ]] || fail 'Usage: add USER EMAIL [SSH_PUBLIC_KEY] [NO_USER_UPDATE]'
		require_username
		require_email
		require_ssh_key
		id -u "$user" >/dev/null 2>&1 && fail "User already exists: $user"
		printf '\nAdd User %s to %s.\nmail to: %s\n\n' "$user" "$domain" "$mailTo"
		add_user
		;;
	del)
		(( EUID == 0 )) || fail 'Please run as root!'
		[[ $# -eq 2 ]] || fail 'Usage: del USER'
		require_username
		check_deletion_target
		[[ -t 0 ]] || fail 'Account deletion requires interactive confirmation'
		printf '\nDelete User %s from %s?\n' "$user" "$domain"
		select answer in Yes No; do
			case "$answer" in
				Yes) del_user; break ;;
				No) break ;;
				*) printf 'Please choose Yes or No.\n' ;;
			esac
		done
		;;
	add_mysql)
		(( EUID == 0 )) || fail 'Please run as root!'
		[[ $# -eq 2 ]] || fail 'Usage: add_mysql USER'
		require_username
		add_user_mysql_db
		;;
	del_mysql)
		(( EUID == 0 )) || fail 'Please run as root!'
		[[ $# -eq 2 ]] || fail 'Usage: del_mysql USER'
		require_username
		del_user_mysql_db
		;;
	*)
		usage >&2
		fail "Unknown command: $cmd"
		;;
esac
